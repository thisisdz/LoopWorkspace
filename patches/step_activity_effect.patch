+/// Custom fork: on/off switch for using step activity in dosing
+public struct StepActivitySelectionView: View {
+    @Binding var isStepActivityEffectEnabled: Bool
+    @State private var authorizationStatus = CMPedometer.authorizationStatus()
+    private static let pedometer = CMPedometer()
+
+    public var body: some View {
+        List {
+            Section {
+                Toggle(NSLocalizedString("Use Step Activity in Dosing", comment: "Toggle title for step activity experiment"), isOn: $isStepActivityEffectEnabled)
+            } footer: {
+                Text(NSLocalizedString("Recent iPhone steps lower predicted glucose for about 90 minutes. Walking pace has the largest effect, brisk pace a smaller one, and running pace none. When off, the effect is still shown on the Predicted Glucose screen but does not affect dosing.", comment: "Step activity experiment description"))
+            }
+            Section {
+                HStack {
+                    Text(NSLocalizedString("Motion & Fitness Access", comment: "Label for motion permission status"))
+                    Spacer()
+                    Text(statusText).foregroundColor(.secondary)
+                }
+                if authorizationStatus == .notDetermined {
+                    Button(NSLocalizedString("Allow Step Access", comment: "Button to request motion permission")) {
+                        requestAccess()
+                    }
+                }
+            }
+        }
+        .navigationTitle(NSLocalizedString("Step Activity Effect", comment: "Title of step activity experiment"))
+    }
+
+    private var statusText: String {
+        switch authorizationStatus {
+        case .authorized: return "Allowed"
+        case .denied: return "Denied (enable in iOS Settings)"
+        case .restricted: return "Restricted"
+        default: return "Not requested"
+        }
+    }
+
+    private func requestAccess() {
+        let now = Date()
+        Self.pedometer.queryPedometerData(from: now.addingTimeInterval(-60), to: now) { _, _ in
+            DispatchQueue.main.async {
+                authorizationStatus = CMPedometer.authorizationStatus()
+            }
+        }
+    }
+}
