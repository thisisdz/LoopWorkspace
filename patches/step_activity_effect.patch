+// MARK: - Step activity effect (custom fork)
+
+/// Converts recent step counts into a temporary glucose-lowering effect.
+/// Parameters were estimated from the owner's own Apple Health history (2022-2026):
+/// steps produce a dip that bottoms out around 30-45 min and is gone by ~90 min.
+/// Zero steps, missing data, or very fast pace all produce zero effect.
+struct StepActivityModel {
+    struct Bin {
+        let start: Date
+        let steps: Double
+    }
+
+    static let binInterval: TimeInterval = .minutes(5)
+    static let effectDuration: TimeInterval = .minutes(90)
+    static let lookback: TimeInterval = .minutes(120)
+
+    /// Pace thresholds, in steps per 5-min bin
+    static let walkingMaxStepsPerBin = 425.0   // <= 85 steps/min
+    static let briskMaxStepsPerBin = 650.0     // <= 130 steps/min; faster (running) gets no effect
+
+    /// Cumulative effect in mg/dL per 1,000 steps, keyed by minutes since the steps
+    static let walkingKernel: [(minutes: Double, mgdL: Double)] = [
+        (0, 0), (10, -6), (20, -10), (30, -11.7), (45, -8), (60, -5), (75, -2), (90, 0)
+    ]
+    static let briskKernel: [(minutes: Double, mgdL: Double)] = [
+        (0, 0), (10, -4), (20, -6.5), (30, -7.2), (45, -6), (60, -4), (75, -1.5), (90, 0)
+    ]
+
+    /// Largest total downward effect allowed at any moment
+    static let maximumEffect = -30.0
+
+    let bins: [Bin]
+
+    private static func interpolate(_ kernel: [(minutes: Double, mgdL: Double)], at minutes: Double) -> Double {
+        guard minutes > 0, let last = kernel.last, minutes < last.minutes else {
+            return 0
+        }
+        for (lower, upper) in zip(kernel, kernel.dropFirst()) where minutes <= upper.minutes {
+            let fraction = (minutes - lower.minutes) / (upper.minutes - lower.minutes)
+            return lower.mgdL + fraction * (upper.mgdL - lower.mgdL)
+        }
+        return 0
+    }
+
+    /// Cumulative activity effect (mg/dL, <= 0) at a given date
+    func value(at date: Date) -> Double {
+        var total = 0.0
+        for bin in bins where bin.steps > 0 {
+            let kernel: [(minutes: Double, mgdL: Double)]
+            if bin.steps <= Self.walkingMaxStepsPerBin {
+                kernel = Self.walkingKernel
+            } else if bin.steps <= Self.briskMaxStepsPerBin {
+                kernel = Self.briskKernel
+            } else {
+                continue
+            }
+            let midpoint = bin.start.addingTimeInterval(Self.binInterval / 2)
+            let minutes = date.timeIntervalSince(midpoint) / 60
+            total += bin.steps / 1000 * Self.interpolate(kernel, at: minutes)
+        }
+        return max(total, Self.maximumEffect)
+    }
+
+    func glucoseEffects(from start: Date, through end: Date) -> [GlucoseEffect] {
+        var effects: [GlucoseEffect] = []
+        var date = start.dateFlooredToTimeInterval(Self.binInterval)
+        while date <= end {
+            effects.append(GlucoseEffect(startDate: date, quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: value(at: date))))
+            date = date.addingTimeInterval(Self.binInterval)
+        }
+        return effects
+    }
+
+    /// Returns the given effect timeline with the activity effect added at each date
+    func adding(to effects: [GlucoseEffect]) -> [GlucoseEffect] {
+        return effects.map { effect in
+            let combined = effect.quantity.doubleValue(for: .milligramsPerDeciliter) + value(at: effect.startDate)
+            return GlucoseEffect(startDate: effect.startDate, quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: combined))
+        }
+    }
+}
+
+/// Reads recent step counts from the iPhone's motion coprocessor
+final class StepActivityStore {
+    private let pedometer = CMPedometer()
+
+    static var isAuthorized: Bool {
+        return CMPedometer.isStepCountingAvailable() && CMPedometer.authorizationStatus() == .authorized
+    }
+
+    /// Synchronously fetches 5-min step bins for the lookback window. Returns nil if unauthorized, on any error, or after a 3 s timeout.
+    func fetchModel(endingAt end: Date) -> StepActivityModel? {
+        guard Self.isAuthorized else {
+            return nil
+        }
+
+        let interval = StepActivityModel.binInterval
+        let lastBinStart = end.dateFlooredToTimeInterval(interval)
+        let binCount = Int(StepActivityModel.lookback / interval)
+        let starts = (0...binCount).map { lastBinStart.addingTimeInterval(-Double(binCount - $0) * interval) }
+
+        let lock = NSLock()
+        var steps: [Date: Double] = [:]
+        var failed = false
+        let group = DispatchGroup()
+
+        for start in starts {
+            let binEnd = min(start.addingTimeInterval(interval), end)
+            guard binEnd > start else { continue }
+            group.enter()
+            pedometer.queryPedometerData(from: start, to: binEnd) { data, error in
+                lock.lock()
+                if let data = data, error == nil {
+                    steps[start] = data.numberOfSteps.doubleValue
+                } else {
+                    failed = true
+                }
+                lock.unlock()
+                group.leave()
+            }
+        }
+
+        guard group.wait(timeout: .now() + 3) == .success else {
+            return nil
+        }
+
+        lock.lock()
+        defer { lock.unlock() }
+        guard !failed else {
+            return nil
+        }
+        let bins = steps.map { StepActivityModel.Bin(start: $0.key, steps: $0.value) }.sorted { $0.start < $1.start }
+        return StepActivityModel(bins: bins)
+    }
+}
