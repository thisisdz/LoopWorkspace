     /// Executes an analysis of the current data, and recommends an adjustment to the current
     /// temporary basal rate.
     ///
+    // MARK: Step study logging (custom)
+
+    /// Writes one CSV row per loop cycle for the step activity study. Never throws; failures only lose the row.
+    private func logStepStudyRow(loopDate: Date, dosingDecision: StoredDosingDecision, error: LoopError?) {
+        dispatchPrecondition(condition: .onQueue(dataAccessQueue))
+
+        let mgdl = HKUnit.milligramsPerDeciliter
+        var row: [String: String] = [:]
+
+        func fmt(_ value: Double?, _ digits: Int = 1) -> String {
+            guard let value = value, value.isFinite else { return "" }
+            return String(format: "%.\(digits)f", value)
+        }
+        func ts(_ date: Date?) -> String {
+            return date.map { StepStudyLogger.timestampFormatter.string(from: $0) } ?? ""
+        }
+
+        // Run metadata
+        row["timestamp_utc"] = ts(loopDate)
+        row["schema_version"] = StepStudyLogger.schemaVersion
+        row["patch_version"] = StepStudyLogger.patchVersion
+        row["loop_completed"] = error == nil ? "1" : "0"
+        row["loop_error"] = error.map { String(String(describing: $0).prefix(200)) } ?? ""
+        row["closed_loop"] = automaticDosingStatus.automaticDosingEnabled ? "1" : "0"
+        row["step_dosing_enabled"] = UserDefaults.standard.stepActivityEffectEnabled ? "1" : "0"
+        row["dosing_strategy"] = settings.automaticDosingStrategy == .automaticBolus ? "automatic_bolus" : "temp_basal_only"
+
+        // Glucose and data quality
+        let glucose = glucoseStore.latestGlucose
+        if let glucose = glucose {
+            row["glucose_time_utc"] = ts(glucose.startDate)
+            row["glucose_mgdl"] = fmt(glucose.quantity.doubleValue(for: mgdl), 0)
+            row["glucose_age_min"] = fmt(loopDate.timeIntervalSince(glucose.startDate) / 60)
+            row["glucose_display_only"] = glucose.isDisplayOnly ? "1" : "0"
+            row["glucose_user_entered"] = glucose.wasUserEntered ? "1" : "0"
+        }
+
+        // Forecasts with and without step activity (same inputs Loop doses from, otherwise)
+        let horizons = [30, 60, 90, 120]
+        let baseInputs = settings.enabledEffects.subtracting(.activity)
+        let forecastWithout = try? predictGlucose(using: baseInputs)
+        let forecastWith = try? predictGlucose(using: baseInputs.union(.activity))
+
+        func forecastValue(_ forecast: [PredictedGlucoseValue]?, minutes: Int) -> Double? {
+            guard let forecast = forecast, let start = forecast.first?.startDate else { return nil }
+            let target = start.addingTimeInterval(TimeInterval(minutes * 60))
+            return forecast.first(where: { $0.startDate >= target })?.quantity.doubleValue(for: mgdl)
+        }
+        for minutes in horizons {
+            row["fc_nosteps_\(minutes)"] = fmt(forecastValue(forecastWithout, minutes: minutes))
+            row["fc_steps_\(minutes)"] = fmt(forecastValue(forecastWith, minutes: minutes))
+        }
+        row["fc_nosteps_eventual"] = fmt(forecastWithout?.last?.quantity.doubleValue(for: mgdl))
+        row["fc_steps_eventual"] = fmt(forecastWith?.last?.quantity.doubleValue(for: mgdl))
+
+        // Each input's contribution from the latest glucose to each horizon
+        func effectDelta(_ effects: [GlucoseEffect]?, minutes: Int) -> Double? {
+            guard let effects = effects, !effects.isEmpty, let start = glucose?.startDate else { return nil }
+            func value(at date: Date) -> Double? {
+                return (effects.last(where: { $0.startDate <= date }) ?? effects.first)?.quantity.doubleValue(for: mgdl)
+            }
+            guard let from = value(at: start), let to = value(at: start.addingTimeInterval(TimeInterval(minutes * 60))) else { return nil }
+            return to - from
+        }
+        let effectSets: [(String, [GlucoseEffect]?)] = [
+            ("insulin", insulinEffect),
+            ("carbs", carbEffect),
+            ("momentum", glucoseMomentumEffect),
+            ("rc", retrospectiveGlucoseEffect),
+            ("activity", activityEffect)
+        ]
+        for (name, effects) in effectSets {
+            for minutes in horizons {
+                row["eff_\(name)_\(minutes)"] = fmt(effectDelta(effects, minutes: minutes))
+            }
+        }
+
+        // Steps and data quality
+        row["step_fetch_status"] = stepActivityStore.lastFetchStatus
+        if let model = stepActivityModel {
+            let recent = model.bins.filter { $0.start >= loopDate.addingTimeInterval(-TimeInterval(30 * 60)) }
+            let walking = recent.filter { $0.steps <= StepActivityModel.walkingMaxStepsPerBin }
+            let brisk = recent.filter { $0.steps > StepActivityModel.walkingMaxStepsPerBin && $0.steps <= StepActivityModel.briskMaxStepsPerBin }
+            let running = recent.filter { $0.steps > StepActivityModel.briskMaxStepsPerBin }
+            row["steps_last30"] = fmt(recent.reduce(0) { $0 + $1.steps }, 0)
+            row["steps_walk_last30"] = fmt(walking.reduce(0) { $0 + $1.steps }, 0)
+            row["steps_brisk_last30"] = fmt(brisk.reduce(0) { $0 + $1.steps }, 0)
+            row["steps_run_last30"] = fmt(running.reduce(0) { $0 + $1.steps }, 0)
+            row["step_bins_last30"] = recent.map { bin -> String in
+                let pace = bin.steps == 0 ? "" : (bin.steps <= StepActivityModel.walkingMaxStepsPerBin ? "w" : (bin.steps <= StepActivityModel.briskMaxStepsPerBin ? "b" : "r"))
+                return "\(Int(bin.steps))\(pace)"
+            }.joined(separator: ";")
+            if let start = glucose?.startDate {
+                row["activity_effect_now"] = fmt(model.value(at: start))
+            }
+        }
+
+        // Core Motion activity classification
+        let (activity, motionStatus) = stepActivityStore.fetchLatestActivity(endingAt: loopDate)
+        row["motion_status"] = motionStatus
+        if let activity = activity {
+            var types: [String] = []
+            if activity.stationary { types.append("stationary") }
+            if activity.walking { types.append("walking") }
+            if activity.running { types.append("running") }
+            if activity.automotive { types.append("automotive") }
+            if activity.cycling { types.append("cycling") }
+            if activity.unknown { types.append("unknown") }
+            row["motion_activity"] = types.joined(separator: ";")
+            switch activity.confidence {
+            case .low: row["motion_confidence"] = "low"
+            case .medium: row["motion_confidence"] = "medium"
+            case .high: row["motion_confidence"] = "high"
+            @unknown default: row["motion_confidence"] = ""
+            }
+            row["motion_start_utc"] = ts(activity.startDate)
+        }
+
+        // Overrides
+        if let override = settings.scheduleOverride, override.isActive(at: loopDate) {
+            switch override.context {
+            case .preset(let preset): row["override"] = "preset:\(preset.name)"
+            case .custom: row["override"] = "custom"
+            case .legacyWorkout: row["override"] = "workout"
+            case .preMeal: row["override"] = "premeal"
+            }
+            row["override_insulin_needs"] = fmt(override.settings.effectiveInsulinNeedsScaleFactor, 2)
+            if let range = override.settings.targetRange {
+                row["override_target_low"] = fmt(range.lowerBound.doubleValue(for: mgdl), 0)
+                row["override_target_high"] = fmt(range.upperBound.doubleValue(for: mgdl), 0)
+            }
+        }
+        if let preMeal = settings.preMealOverride, preMeal.isActive(at: loopDate) {
+            row["premeal_active"] = "1"
+        }
+
+        // Settings in effect (after overrides)
+        row["isf_mgdl_per_u"] = fmt(insulinSensitivityScheduleApplyingOverrideHistory?.quantity(at: loopDate).doubleValue(for: mgdl))
+        row["carb_ratio_g_per_u"] = fmt(carbRatioScheduleApplyingOverrideHistory?.quantity(at: loopDate).doubleValue(for: .gram()))
+        if let targetRange = settings.effectiveGlucoseTargetRangeSchedule()?.quantityRange(at: loopDate) {
+            row["target_low"] = fmt(targetRange.lowerBound.doubleValue(for: mgdl), 0)
+            row["target_high"] = fmt(targetRange.upperBound.doubleValue(for: mgdl), 0)
+        }
+
+        // Insulin and carbs on board, and the dose decision
+        row["iob_u"] = fmt(dosingDecision.insulinOnBoard?.value, 2)
+        row["cob_g"] = fmt(dosingDecision.carbsOnBoard?.quantity.doubleValue(for: .gram()), 0)
+        if let recommendation = dosingDecision.automaticDoseRecommendation {
+            row["rec_temp_basal_u_per_hr"] = fmt(recommendation.basalAdjustment?.unitsPerHour, 3)
+            row["rec_temp_basal_min"] = fmt(recommendation.basalAdjustment.map { $0.duration / 60 }, 0)
+            row["rec_bolus_u"] = fmt(recommendation.bolusUnits, 3)
+            row["rec_enacted"] = (automaticDosingStatus.automaticDosingEnabled && error == nil) ? "1" : "0"
+        }
+
+        StepStudyLogger.shared.append(row, date: loopDate)
+    }
+
