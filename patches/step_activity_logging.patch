+/// Appends study rows to monthly CSV files in Application Support/StepStudy (not visible in Files; exported from Settings)
+final class StepStudyLogger {
+    static let shared = StepStudyLogger()
+    static let schemaVersion = "1"
+    static let patchVersion = "step-activity-1.1"
+
+    static let columns: [String] = {
+        var columns = [
+            "timestamp_utc", "schema_version", "patch_version", "loop_completed", "loop_error",
+            "closed_loop", "step_dosing_enabled", "dosing_strategy",
+            "glucose_time_utc", "glucose_mgdl", "glucose_age_min", "glucose_display_only", "glucose_user_entered"
+        ]
+        let horizons = [30, 60, 90, 120]
+        for minutes in horizons {
+            columns += ["fc_nosteps_\(minutes)", "fc_steps_\(minutes)"]
+        }
+        columns += ["fc_nosteps_eventual", "fc_steps_eventual"]
+        for name in ["insulin", "carbs", "momentum", "rc", "activity"] {
+            for minutes in horizons {
+                columns.append("eff_\(name)_\(minutes)")
+            }
+        }
+        columns += [
+            "step_fetch_status", "steps_last30", "steps_walk_last30", "steps_brisk_last30", "steps_run_last30",
+            "step_bins_last30", "activity_effect_now",
+            "motion_status", "motion_activity", "motion_confidence", "motion_start_utc",
+            "override", "override_insulin_needs", "override_target_low", "override_target_high", "premeal_active",
+            "isf_mgdl_per_u", "carb_ratio_g_per_u", "target_low", "target_high",
+            "iob_u", "cob_g", "rec_temp_basal_u_per_hr", "rec_temp_basal_min", "rec_bolus_u", "rec_enacted"
+        ]
+        return columns
+    }()
+
+    static let timestampFormatter: ISO8601DateFormatter = {
+        let formatter = ISO8601DateFormatter()
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        return formatter
+    }()
+
+    private static let monthFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(identifier: "UTC")
+        formatter.dateFormat = "yyyy-MM"
+        return formatter
+    }()
+
+    private let queue = DispatchQueue(label: "com.loopkit.StepStudyLogger", qos: .utility)
+
+    static var directory: URL? {
+        guard let support = try? FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true) else {
+            return nil
+        }
+        return support.appendingPathComponent("StepStudy", isDirectory: true)
+    }
+
+    static func logFiles() -> [URL] {
+        guard let directory = directory,
+              let files = try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) else {
+            return []
+        }
+        return files.filter { $0.pathExtension == "csv" }.sorted { $0.lastPathComponent < $1.lastPathComponent }
+    }
+
+    private static func escape(_ value: String) -> String {
+        if value.contains(",") || value.contains("\"") || value.contains("\n") {
+            return "\"" + value.replacingOccurrences(of: "\"", with: "\"\"") + "\""
+        }
+        return value
+    }
+
+    func append(_ values: [String: String], date: Date) {
+        queue.async {
+            guard let directory = Self.directory else { return }
+            let protection: [FileAttributeKey: Any] = [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication]
+            let url = directory.appendingPathComponent("loop_study_\(Self.monthFormatter.string(from: date)).csv")
+            let line = Self.columns.map { Self.escape(values[$0] ?? "") }.joined(separator: ",") + "\n"
+            do {
+                try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true, attributes: protection)
+                if !FileManager.default.fileExists(atPath: url.path) {
+                    let header = Self.columns.joined(separator: ",") + "\n"
+                    FileManager.default.createFile(atPath: url.path, contents: Data((header + line).utf8), attributes: protection)
+                } else {
+                    let handle = try FileHandle(forWritingTo: url)
+                    defer { try? handle.close() }
+                    try handle.seekToEnd()
+                    try handle.write(contentsOf: Data(line.utf8))
+                }
+            } catch {
+                // Logging must never affect looping; a failed write only loses this row
+            }
+        }
+    }
 }
