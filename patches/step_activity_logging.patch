     }
+
+    /// Most recent Core Motion activity classification in the last 10 minutes, with a status string. Waits at most 1.5 s.
+    func fetchLatestActivity(endingAt end: Date) -> (CMMotionActivity?, String) {
+        guard CMMotionActivityManager.isActivityAvailable() else {
+            return (nil, "unavailable")
+        }
+        guard CMMotionActivityManager.authorizationStatus() == .authorized else {
+            return (nil, "unauthorized")
+        }
+
+        let semaphore = DispatchSemaphore(value: 0)
+        let lock = NSLock()
+        var latest: CMMotionActivity?
+        var status = "error"
+
+        activityManager.queryActivityStarting(from: end.addingTimeInterval(-TimeInterval(10 * 60)), to: end, to: motionQueue) { activities, error in
+            lock.lock()
+            if error == nil {
+                latest = activities?.last
+                status = "ok"
+            }
+            lock.unlock()
+            semaphore.signal()
+        }
+
+        guard semaphore.wait(timeout: .now() + 1.5) == .success else {
+            return (nil, "timeout")
+        }
+        lock.lock()
+        defer { lock.unlock() }
+        return (latest, status)
+    }
+}
